{
    "name": "projek-xyz/callable",
    "description": "Auto-wire and invoke any callable through PSR-11",
    "keywords": ["callable-resolver", "callable-handler", "dependency-injection", "di", "psr-11"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Fery Wardiyanto",
            "email": "ferywardiyanto@gmail.com"
        }
    ],
    "support": {
        "source": "https://github.com/projek-xyz/callable"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/feryardiant"
        }
    ],
    "scripts": {
        "format": "pint",
        "lint": "pint --test",
        "spec": "kahlan --config=tests/config.php",
        "test": [
            "@lint",
            "@spec"
        ]
    },
    "autoload": {
        "psr-4": {
            "Projek\\Callable\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Stubs\\": "tests/stubs"
        }
    },
    "require": {
        "php": ">=8.4",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "kahlan/kahlan": "^6.1",
        "laravel/pint": "^1.32"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
